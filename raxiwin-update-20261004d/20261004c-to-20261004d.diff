 /**
+ * Seconds the public record times run behind the true placement time, so the
+ * timestamp shown for a bet matches the period label shown for it (the whole
+ * WinGo presentation carries the same label offset).
+ */
+function sl_display_time_shift_seconds($gameCode)
+{
+    if (strpos((string) $gameCode, 'WinGo_') !== 0) {
+        return 0;
+    }
+    $offset = sl_display_label_offset();
+    if ($offset === 0) {
+        return 0;
+    }
+    return $offset * sl_interval_seconds($gameCode);
+}
