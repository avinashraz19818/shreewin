+/**
+ * True when the bet table carries the per-bet settlement deadline.
+ */
+function sl_bets_have_settle_after()
+{
+    static $has = null;
+    if ($has === null) {
+        global $conn;
+        $has = false;
+        try {
+            $has = function_exists('app_column_exists') && app_column_exists('saas_lottery_bets', 'settle_after');
+        } catch (Throwable $e) {
+            $has = false;
+        }
+    }
+    return $has;
+}
+
+/**
+ * Add or subtract small values from a numeric issue label without touching
+ * floats (labels carry seventeen digits).
+ */
+function sl_issue_shift($issue, $delta)
+{
+    $issue = preg_replace('/[^0-9]/', '', (string) $issue);
+    if ($issue === '' || strlen($issue) > 18) {
+        return (string) $issue;
+    }
+    $digits = str_split($issue);
+    $carry = $delta > 0 ? 1 : -1;
+    for ($step = 0; $step < abs((int) $delta); $step++) {
+        $i = count($digits) - 1;
+        while ($i >= 0) {
+            $digit = (int) $digits[$i] + $carry;
+            if ($digit >= 0 && $digit <= 9) {
+                $digits[$i] = (string) $digit;
+                break;
+            }
+            $digits[$i] = $carry > 0 ? '0' : '9';
+            $i--;
+        }
+        if ($i < 0) {
+            break;
+        }
+    }
+    return implode('', $digits);
+}
