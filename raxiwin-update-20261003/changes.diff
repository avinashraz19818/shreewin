+/**
+ * Read the immutable draw that is already stored for a period.
+ */
+function sl_stored_result($gameCode, $issue)
+{
+    global $conn;
+    $gameCode = (string) $gameCode;
+    $issue = (string) $issue;
+    if ($gameCode === '' || $issue === '') {
+        return null;
+    }
+    $stmt = $conn->prepare('SELECT issue_number,premium,number,color,result_sum FROM saas_lottery_results WHERE game_code=? AND issue_number=? LIMIT 1');
+    if (!$stmt) {
+        return null;
+    }
+    $stmt->bind_param('ss', $gameCode, $issue);
+    $stmt->execute();
+    $result = $stmt->get_result();
+    $row = $result ? $result->fetch_assoc() : null;
+    $stmt->close();
+    if (!$row) {
+        return null;
+    }
+    return array(
+        'issueNumber'=>(string) $row['issue_number'],
+        'premium'=>(string) $row['premium'],
+        'number'=>(string) $row['number'],
+        'color'=>(string) $row['color'],
+        'sum'=>(int) $row['result_sum']
+    );
+}
+
+/**
+ * Settle every pending bet of a period whose draw is already stored.
+ *
+ * sl_save_and_settle_results() never rewrites an existing result row, so a bet
+ * that arrives for a period that was drawn a moment earlier would otherwise
+ * stay 'pending' forever (the client polls GetWinLossResult for the period it
+ * bet on and must get the won/lost answer immediately).
+ *
+ * Returns true when a stored draw exists for the period.
+ */
+function sl_settle_pending_from_stored($gameCode, $issue)
+{
+    global $conn;
+    $item = sl_stored_result($gameCode, $issue);
+    if (!$item) {
+        return false;
+    }
+    $stmt = $conn->prepare("SELECT COUNT(*) FROM saas_lottery_bets WHERE game_code=? AND issue_number=? AND status='pending'");
+    if (!$stmt) {
+        return true;
+    }
+    $stmt->bind_param('ss', $gameCode, $issue);
+    $stmt->execute();
+    $pending = 0;
+    $stmt->bind_result($pending);
+    $stmt->fetch();
+    $stmt->close();
+    if ((int) $pending > 0) {
+        sl_settle_issue($gameCode, $issue, $item);
+    }
+    return true;
+}
