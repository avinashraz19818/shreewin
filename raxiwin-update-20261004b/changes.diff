+/**
+ * Add or subtract small values from a numeric issue label without touching
+ * floats (labels carry seventeen digits).
+ */
+function sl_issue_shift($issue, $delta)
+{
+    $issue = preg_replace('/[^0-9]/', '', (string) $issue);
+    if ($issue === '' || strlen($issue) > 18) {
+        return (string) $issue;
+    }
+    $digits = str_split($issue);
+    $carry = $delta > 0 ? 1 : -1;
+    for ($step = 0; $step < abs((int) $delta); $step++) {
+        $i = count($digits) - 1;
+        while ($i >= 0) {
+            $digit = (int) $digits[$i] + $carry;
+            if ($digit >= 0 && $digit <= 9) {
+                $digits[$i] = (string) $digit;
+                break;
+            }
+            $digits[$i] = $carry > 0 ? '0' : '9';
+            $i--;
+        }
+        if ($i < 0) {
+            break;
+        }
+    }
+    return implode('', $digits);
+}
+
+/**
+ * How far the public WinGo screen labels run behind the provider feed.
+ * -1 = the whole app is one period behind (default), 0 = canonical labels.
+ * The settlement mapping derives from the same value, so display, bets and
+ * results can never drift apart when this is changed.
+ */
+function sl_display_label_offset()
+{
+    static $offset = null;
+    if ($offset === null) {
+        $offset = (int) app_setting('raxiwin_period_label_offset', '-1');
+        if ($offset > 0 || $offset < -3) {
+            $offset = -1;
+        }
+    }
+    return $offset;
+}
