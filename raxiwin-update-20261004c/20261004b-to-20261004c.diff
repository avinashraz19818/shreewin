+/**
+ * Earliest settlement deadline among the pending bets of one label. 0 when the
+ * table has no settle_after column or nothing is pending.
+ */
+function sl_bet_defer_until($gameCode, $issue)
+{
+    global $conn;
+    if (!sl_bets_have_settle_after()) {
+        return 0;
+    }
+    $stmt = $conn->prepare("SELECT MIN(settle_after) FROM saas_lottery_bets WHERE game_code=? AND issue_number=? AND status='pending'");
+    if (!$stmt) {
+        return 0;
+    }
+    $stmt->bind_param('ss', $gameCode, $issue);
+    $stmt->execute();
+    $stmt->bind_result($min);
+    $stmt->fetch();
+    $stmt->close();
+    return (int) $min;
+}
